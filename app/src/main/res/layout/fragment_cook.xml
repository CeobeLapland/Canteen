<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootCook"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF7EC"
    android:padding="16dp"
    tools:context="com.example.canteen.controller.CookFragment">

    <TextView
        android:id="@+id/tvIngredientTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="食材区"
        android:textColor="#E65100"
        android:textSize="12sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupTags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp"
        app:singleLine="false" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvIngredients"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="10dp"
        android:background="#FFFDF8"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="always"
        android:padding="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShowCustomInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="+"
        android:textColor="#FFFFFF"
        app:cornerRadius="18dp"
        app:backgroundTint="#FB8C00" />

    <LinearLayout
        android:id="@+id/layoutCustomInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/etCustomIngredient"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:hint="输入自定义食材"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="#4E342E"
            android:textColorHint="#A1887F" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmCustom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="确定"
            android:textColor="#FFFFFF"
            app:cornerRadius="18dp"
            app:backgroundTint="#EF6C00" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPotTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="锅"
        android:textColor="#E65100"
        android:textSize="12sp"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPotContainer"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeColor="#FFB74D"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="#FFF3E0">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="always"
            android:padding="6dp" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartCooking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="开始做饭"
        android:textColor="#FFFFFF"
        app:cornerRadius="18dp"
        app:backgroundTint="#FB8C00" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRecipe"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeColor="#FFCC80"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="#FFFDF8">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvRecipe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="这里会显示根据锅里食材生成的食谱。"
                android:textColor="#5D4037"
                android:textSize="12sp" />
        </androidx.core.widget.NestedScrollView>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>